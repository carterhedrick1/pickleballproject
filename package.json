{
  "name": "pickleball-scheduler",
  "version": "1.0.0",
  "description": "A scheduling app for pickleball games",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test 'test/**/*.test.js'",
    "verify:app": "node verify/user-flow.js http://localhost:3002 --create",
    "verify:races": "node verify/signup-race.js && node verify/capacity-race.js && node verify/mixed-race.js",
    "verify:roster": "node verify/roster-locations.js",
    "verify:promotion": "node verify/promotion-modes.js",
    "verify:photos": "node verify/photos.js",
    "verify:court-images": "node verify/court-images.js",
    "verify:stats": "node verify/stats.js",
    "verify:sms": "node verify/sms-cancel.js",
    "verify:reminders": "node verify/reminder-catchup.js",
    "verify:reminder-safety": "node verify/reminder-safety.js",
    "verify:late-joiner": "node verify/reminder-late-joiner.js",
    "verify:sms-failure": "node verify/sms-failure.js",
    "verify:sms-failure-ui": "node verify/sms-failure-ui.js",
    "quota": "node scripts/textbelt-quota.js",
    "docs": "npm run docs:copy && npm run docs:screens",
    "docs:copy": "node scripts/extract-copy.js",
    "docs:screens": "node scripts/capture-screens.js",
    "docs:publish": "node scripts/publish-docs.js"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.16.0",
    "sqlite3": "^5.1.7",
    "validator": "^13.15.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
